# Copy to .env for production deployment (docker-compose.prod.yml).
# .env is gitignored — keep real values out of the repo.

# Domain with an A record pointing to this VM (Caddy issues HTTPS for it).
DOMAIN=testapiserver.online

# Optional: uncomment and set to also expose the server directly on the host.
# (Not needed behind Caddy.)
# PORT=3000
